GEMINI_API_KEY=your-api-key-here

# tools/vault.py: Fernet key for the dynamic secrets store (Spotify refresh
# token, etc.). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CAUTION: changing VAULT_KEY invalidates every secret already stored in
# tools/vault_data/ - don't rotate it casually.
VAULT_KEY=TPEdXAFivxXnZi6J2ZAKbzzZb0hFQZqUGWLD_9LmFJs=

# Spotify Web API integration (integrations/spotify/). App creds from
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must be registered in the Spotify app's "Redirect URIs" AND keep this base
# URI (scheme + host + port) exactly. The one-time auth flow in
# `python -m integrations.spotify.auth` binds its local callback server here.
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Only used if/when swapped back to Porcupine for wake-word detection.
# Picovoice access key (get one free at console.picovoice.ai).
PICOVOICE_ACCESS_KEY=

# Only used if/when swapped back to Porcupine.
# Path to the custom "Eden" wake-word file (.ppn), trained at console.picovoice.ai.
# Leave empty to run on Porcupine's built-in "computer" keyword as a placeholder.
WAKE_WORD_MODEL_PATH=